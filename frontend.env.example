# NKP Logistics — Next.js frontend environment
# Copy to frontend/.env for local development. In production set this in the
# Vercel dashboard under Settings → Environment Variables.

# The browser calls the API directly, so this must be the PUBLIC backend URL.
# NEXT_PUBLIC_* values are inlined at build time, which means changing this in
# Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8080
