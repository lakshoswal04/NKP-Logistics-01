# NKP Logistics — FastAPI backend environment
# Copy to backend/.env for local development. In production these are set in
# the Render dashboard (or generated by render.yaml) rather than in a file.

ENVIRONMENT=development           # "production" enables the boot-time safety guards
DEBUG=true                        # must be false in production; exposes /docs and tracebacks

# Local Postgres. In production Render injects its own connection string, which
# arrives as postgres://… and is rewritten to postgresql+asyncpg://… on load.
DATABASE_URL=postgresql+asyncpg://nkp:nkp@localhost:5432/nkp_logistics

# Generate with: openssl rand -hex 32
# The app refuses to boot in production with the placeholder or anything under
# 32 characters — a weak signing key is a full authentication bypass.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated, or a JSON array. Must include the web app's exact origin.
CORS_ORIGINS=http://localhost:5001
# Vercel preview deployments get a new hostname per commit, so they are matched
# by pattern instead. Scope it to your project, not all of vercel.app:
# CORS_ORIGIN_REGEX=^https://nkp-logistics-[a-z0-9-]+\.vercel\.app$

WEB_BASE_URL=http://localhost:5001   # used to build links inside emails

# Seeds the demo dataset on boot if the database is empty. Idempotent.
SEED_ON_START=false

# --- Providers ---------------------------------------------------------------
# All optional. Left empty, each falls back to a mock and the app runs fully —
# the UI states which mode it is in rather than pretending.

# AI Control Tower. Without this the tools run on deterministic rules against
# the same live data, and every result is badged "Rules" instead of "Gemini".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email: mock | resend. The mock writes viewable messages to backend/var/outbox.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=NKP Logistics <notifications@nkplogistics.in>
SALES_NOTIFICATION_EMAIL=sales@nkplogistics.in
SUPPORT_NOTIFICATION_EMAIL=support@nkplogistics.in

# Payments: mock | razorpay. Use Razorpay TEST keys — they start with rzp_test_.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: distance lookups fall back to a great-circle estimate without this.
GOOGLE_MAPS_API_KEY=
